# Server
PORT=3000
OCPP_PORT=9000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ev_charging?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OCPP Basic Auth
# Per-unit keys are stored in the Charger document (AuthorizationKey field).
# This env var is the fallback for the demo/test unit only.
OCPP_DEFAULT_AUTH_KEY=changeme

# Payment Gateway (OPEN QUESTION: choose one before Phase 1 go-live)
# PAYHERE_MERCHANT_ID=
# PAYHERE_SECRET=
# STRIPE_SECRET_KEY=

# Commission
COMMISSION_RATE_BPS=1000

# Internal
LOG_LEVEL=info
