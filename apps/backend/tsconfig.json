{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@ev/shared": ["../../packages/shared/dist"],
      "@ev/db": ["../../packages/db/dist"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
