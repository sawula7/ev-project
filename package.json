{
  "name": "ev-charging-marketplace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/admin-web",
    "infra"
  ],
  "scripts": {
    "dev:backend": "yarn workspace @ev/backend dev",
    "build:backend": "yarn workspace @ev/backend build",
    "test:backend": "yarn workspace @ev/backend test",
    "build:shared": "yarn workspace @ev/shared build",
    "build:db": "yarn workspace @ev/db build",
    "dev:admin": "yarn workspace @ev/admin-web dev",
    "build:admin": "yarn workspace @ev/admin-web build",
    "seed": "npx ts-node --project apps/backend/tsconfig.json scripts/seed.ts",
    "simulate": "node scripts/simulate-charger.js",
    "test:local": "bash scripts/local-test.sh",
    "cdk": "yarn workspace @ev/infra cdk",
    "infra:diff": "yarn workspace @ev/infra diff",
    "infra:deploy": "yarn workspace @ev/infra deploy",
    "infra:destroy": "yarn workspace @ev/infra destroy"
  }
}
